{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "SUPABASE_SERVICE_ROLE_KEY",
    "CUSTOMER_PORTAL_HMAC_KEY",
    "GIFT_CARD_HMAC_KEY",
    "COREVO_COMMERCE_RELEASE",
    "COREVO_COMMERCE_TENANT_IDS",
    "COREVO_GIFT_CARD_VALUE_RELEASE",
    "COREVO_GIFT_CARD_TENANT_IDS",
    "COREVO_PAYPAL_RELEASE",
    "COREVO_PAYPAL_TENANT_IDS",
    "COREVO_BOOKING_PAYMENT_RELEASE",
    "COREVO_BOOKING_PAYMENT_TENANT_IDS",
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_ROOT_DOMAIN",
    "NEXT_PUBLIC_PLATFORM_HOST",
    "NEXT_PUBLIC_SUPERADMIN_HOST",
    "NEXT_PUBLIC_CUSTOMER_PORTAL_HOST",
    "NEXT_PUBLIC_RESERVED_SUBDOMAINS",
    "AUTH_COOKIE_DOMAIN",
    "R2_BUCKET_NAME",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", ".open-next/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "cache": false
    }
  }
}
