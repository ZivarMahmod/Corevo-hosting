{
  "name": "@corevo/zivar-graph-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first desktop graph studio for Graphify projects",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "check": "node self-check.cjs",
    "test:e2e": "node ../../node_modules/@playwright/test/cli.js test -c playwright.config.cjs",
    "build": "electron-builder --dir --win --x64",
    "dist": "electron-builder --win portable --x64",
    "typecheck": "node --check main.cjs && node --check preload.cjs && node --check graph-engine.cjs && node --check branch-lens.cjs && node --check activity-engine.js && node --check brain-layout.js && node --check brain-bootstrap.mjs && node --check brain-graph-3d.mjs && node --check local-server.cjs && node --check renderer.js",
    "test": "node self-check.cjs"
  },
  "devDependencies": {
    "electron": "41.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "se.corevo.zivar-graph-studio",
    "productName": "Zivar Graph Studio",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "graph-engine.cjs",
      "branch-lens.cjs",
      "activity-engine.js",
      "brain-layout.js",
      "brain-bootstrap.mjs",
      "brain-graph-3d.mjs",
      "local-server.cjs",
      "renderer.js",
      "studio.html",
      "styles.css",
      "vendor/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Zivar-Graph-Studio-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
